{
  "name": "shadowmap",
  "version": "0.1.0",
  "description": "Find vibe-coded apps and vibe-coding platforms in DNS, proxy and security logs",
  "keywords": [
    "cloudflare",
    "defender",
    "dns",
    "logs",
    "lovable",
    "netskope",
    "shadow-it",
    "vercel",
    "vibe-coding",
    "zscaler"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/widefleet/shadowmap.git"
  },
  "bin": {
    "shadowmap": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm typecheck && pnpm format:check && pnpm lint && pnpm test",
    "prepublishOnly": "pnpm check && pnpm build"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.86.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "26.6.4",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.2"
}
